{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JourneyExecutionResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["journey", "results"],
  "properties": {
    "journey": { "type": "string" },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action_id", "status", "commands", "comment"],
        "properties": {
          "action_id": {
            "type": "string",
            "pattern": "^action-[1-9][0-9]*$",
            "description": "Copy the stable id attribute from the corresponding requested action."
          },
          "status": {
            "type": "string",
            "enum": ["PASSED", "FAILED", "SKIPPED"],
            "description": "PASSED means the requested driver interaction was dispatched, not that the app behaved correctly."
          },
          "commands": {
            "type": "array",
            "items": { "type": "string" }
          },
          "comment": { "type": "string" }
        }
      }
    }
  }
}
