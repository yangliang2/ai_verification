{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JourneyExecutionResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["journey", "results"],
  "properties": {
    "journey": { "type": "string" },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "status", "commands", "comment"],
        "properties": {
          "action": { "type": "string" },
          "status": { "type": "string", "enum": ["PASSED", "FAILED", "SKIPPED"] },
          "commands": {
            "type": "array",
            "items": { "type": "string" }
          },
          "comment": { "type": "string" }
        }
      }
    }
  }
}
