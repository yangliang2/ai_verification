{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/aiverify/discovery-schema-v1.json",
  "title": "AI Verification M7 discovery contracts",
  "type": "object",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "textArray": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "locator": {"type": "string", "minLength": 1}
      }
    },
    "contextFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_id", "subject", "predicate", "value", "source_kind",
        "provenance", "source_version", "confidence", "status"
      ],
      "properties": {
        "fact_id": {"type": "string", "minLength": 1},
        "subject": {"type": "string", "minLength": 1},
        "predicate": {"type": "string", "minLength": 1},
        "value": {},
        "source_kind": {
          "enum": ["declared", "derived", "observed", "historical", "unknown"]
        },
        "provenance": {
          "type": "array",
          "items": {"$ref": "#/$defs/provenance"}
        },
        "source_version": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "status": {"enum": ["known", "inferred", "unknown", "contradictory", "stale"]},
        "rationale": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "unknown"}}},
          "then": {
            "properties": {"source_kind": {"const": "unknown"}, "rationale": {"type": "string", "minLength": 1}},
            "required": ["rationale"]
          }
        },
        {
          "if": {"properties": {"status": {"enum": ["known", "inferred", "contradictory", "stale"]}}},
          "then": {"properties": {"provenance": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"source_kind": {"const": "unknown"}}},
          "then": {"properties": {"status": {"const": "unknown"}}}
        }
      ]
    },
    "contextNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "kind", "label", "source_fact_ids", "status"],
      "properties": {
        "node_id": {"type": "string", "minLength": 1},
        "kind": {
          "enum": ["component", "api", "operation", "thread", "process", "quality_contract", "resource"]
        },
        "label": {"type": "string", "minLength": 1},
        "source_fact_ids": {"$ref": "#/$defs/textArray", "minItems": 1},
        "status": {"enum": ["known", "inferred", "unknown", "contradictory", "stale"]}
      }
    },
    "contextEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_id", "from_node_id", "to_node_id", "kind", "semantics",
        "source_fact_ids", "status"
      ],
      "properties": {
        "edge_id": {"type": "string", "minLength": 1},
        "from_node_id": {"type": "string", "minLength": 1},
        "to_node_id": {"type": "string", "minLength": 1},
        "kind": {
          "enum": ["calls", "provides", "depends_on", "runs_on", "runs_in", "constrained_by", "critical_path"]
        },
        "semantics": {"enum": ["synchronous", "asynchronous", "unknown"]},
        "source_fact_ids": {"$ref": "#/$defs/textArray", "minItems": 1},
        "status": {"enum": ["known", "inferred", "unknown", "contradictory", "stale"]}
      }
    },
    "contextGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "graph_id", "target_id", "facts"],
      "properties": {
        "schema_version": {"const": 1},
        "graph_id": {"type": "string", "minLength": 1},
        "target_id": {"type": "string", "minLength": 1},
        "facts": {
          "type": "array",
          "items": {"$ref": "#/$defs/contextFact"}
        },
        "nodes": {
          "type": "array",
          "items": {"$ref": "#/$defs/contextNode"}
        },
        "edges": {
          "type": "array",
          "items": {"$ref": "#/$defs/contextEdge"}
        },
        "source_origin": {"type": "string", "minLength": 1},
        "source_commit": {"type": "string", "minLength": 1},
        "source_tree_sha256": {"$ref": "#/$defs/sha256"}
      },
      "allOf": [
        {
          "if": {"required": ["source_origin"]},
          "then": {"required": ["source_commit", "source_tree_sha256"]}
        },
        {
          "if": {"required": ["source_commit"]},
          "then": {"required": ["source_origin", "source_tree_sha256"]}
        },
        {
          "if": {"required": ["source_tree_sha256"]},
          "then": {"required": ["source_origin", "source_commit"]}
        }
      ]
    },
    "contextAcquisitionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "target", "requested_evidence", "suggestions"],
      "properties": {
        "schema_version": {"const": 1},
        "target": {"$ref": "#/$defs/projectTarget"},
        "requested_evidence": {"$ref": "#/$defs/textArray", "minItems": 1},
        "suggestions": {"$ref": "#/$defs/textArray"}
      }
    },
    "contextAcquisitionAdapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_id", "status", "inspected_files", "facts_emitted", "unresolved"],
      "properties": {
        "adapter_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["complete", "partial", "unsupported", "budget-exhausted"]},
        "inspected_files": {"$ref": "#/$defs/textArray"},
        "facts_emitted": {"type": "integer", "minimum": 0},
        "unresolved": {"$ref": "#/$defs/textArray"}
      }
    },
    "contextAcquisitionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "target_id", "source_origin", "source_commit", "source_tree_sha256",
        "requested_evidence", "inspected_scope", "skipped_scope", "discovery_budget", "budget_used",
        "graph_sha256", "adapters", "unresolved", "suggested_probes", "coverage_frontier",
        "no_diff", "status"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "target_id": {"type": "string", "minLength": 1},
        "source_origin": {"type": "string", "minLength": 1},
        "source_commit": {"type": "string", "minLength": 1},
        "source_tree_sha256": {"$ref": "#/$defs/sha256"},
        "requested_evidence": {"$ref": "#/$defs/textArray", "minItems": 1},
        "inspected_scope": {"$ref": "#/$defs/textArray"},
        "skipped_scope": {"$ref": "#/$defs/textArray"},
        "discovery_budget": {"type": "integer", "minimum": 1},
        "budget_used": {"type": "integer", "minimum": 0},
        "graph_sha256": {"$ref": "#/$defs/sha256"},
        "adapters": {
          "type": "array",
          "items": {"$ref": "#/$defs/contextAcquisitionAdapter"}
        },
        "unresolved": {"$ref": "#/$defs/textArray"},
        "suggested_probes": {"$ref": "#/$defs/textArray"},
        "coverage_frontier": {"$ref": "#/$defs/textArray"},
        "no_diff": {"const": true},
        "status": {"enum": ["complete", "partial", "rejected"]}
      }
    },
    "contextAcquisitionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "target", "graph", "receipt"],
      "properties": {
        "schema_version": {"const": 1},
        "target": {"$ref": "#/$defs/projectTarget"},
        "graph": {"$ref": "#/$defs/contextGraph"},
        "receipt": {"$ref": "#/$defs/contextAcquisitionReceipt"}
      }
    },
    "changeTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "schema_version", "target_id", "source_origin", "source_commit",
        "worktree", "diff_ref", "diff_sha256"
      ],
      "properties": {
        "kind": {"const": "change"},
        "schema_version": {"const": 1},
        "target_id": {"type": "string", "minLength": 1},
        "source_origin": {"type": "string", "minLength": 1},
        "source_commit": {"type": "string", "minLength": 1},
        "worktree": {"type": "string", "minLength": 1},
        "diff_ref": {"type": "string", "minLength": 1},
        "diff_sha256": {"$ref": "#/$defs/sha256"},
        "spec_ref": {"type": "string", "minLength": 1}
      }
    },
    "projectTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "schema_version", "target_id", "source_origin", "source_commit",
        "worktree", "scope", "discovery_budget"
      ],
      "properties": {
        "kind": {"const": "project"},
        "schema_version": {"const": 1},
        "target_id": {"type": "string", "minLength": 1},
        "source_origin": {"type": "string", "minLength": 1},
        "source_commit": {"type": "string", "minLength": 1},
        "worktree": {"type": "string", "minLength": 1},
        "scope": {"$ref": "#/$defs/textArray", "minItems": 1},
        "discovery_budget": {"type": "integer", "minimum": 1}
      }
    },
    "target": {
      "oneOf": [
        {"$ref": "#/$defs/changeTarget"},
        {"$ref": "#/$defs/projectTarget"}
      ]
    },
    "qualityContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "contract_id", "name", "scope", "quality_property", "constraint", "source_fact_ids", "status"],
      "properties": {
        "schema_version": {"const": 1},
        "contract_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "quality_property": {"type": "string", "minLength": 1},
        "constraint": {"type": "string", "minLength": 1},
        "source_fact_ids": {"$ref": "#/$defs/textArray", "minItems": 1},
        "status": {"enum": ["declared", "derived", "observed", "unknown"]}
      }
    },
    "contractDrift": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "drift_id", "contract_id", "before", "after", "delta", "source_fact_ids", "status", "rationale"],
      "properties": {
        "schema_version": {"const": 1},
        "drift_id": {"type": "string", "minLength": 1},
        "contract_id": {"type": "string", "minLength": 1},
        "before": {"type": "string", "minLength": 1},
        "after": {"type": "string", "minLength": 1},
        "delta": {"type": "string", "minLength": 1},
        "source_fact_ids": {"$ref": "#/$defs/textArray", "minItems": 1},
        "status": {"enum": ["suspected", "observed", "contradictory", "unknown"]},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "behaviorDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "delta_id", "target_id", "subject", "before", "after",
        "source_fact_ids", "confidence", "status", "rationale"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "delta_id": {"type": "string", "minLength": 1},
        "target_id": {"type": "string", "minLength": 1},
        "subject": {"type": "string", "minLength": 1},
        "before": {"type": "string", "minLength": 1},
        "after": {"type": "string", "minLength": 1},
        "source_fact_ids": {"$ref": "#/$defs/textArray", "minItems": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "status": {"enum": ["inferred", "observed", "unknown", "contradictory"]},
        "contract_drift_id": {"type": "string", "minLength": 1},
        "rationale": {"type": "string"}
      }
    },
    "riskPriority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "priority_id", "impact", "propagation_reach",
        "context_sensitivity", "uncertainty", "evidence_gap", "estimated_probe_cost",
        "rationale", "score"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "priority_id": {"type": "string", "minLength": 1},
        "impact": {"type": "number", "minimum": 0, "maximum": 1},
        "propagation_reach": {"type": "number", "minimum": 0, "maximum": 1},
        "context_sensitivity": {"type": "number", "minimum": 0, "maximum": 1},
        "uncertainty": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_gap": {"type": "number", "minimum": 0, "maximum": 1},
        "estimated_probe_cost": {"type": "number", "minimum": 0, "maximum": 1},
        "rationale": {"type": "string", "minLength": 1},
        "score": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "riskPrior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "prior_id", "name", "description", "signals", "operator_ids", "version"],
      "properties": {
        "schema_version": {"const": 1},
        "prior_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "signals": {"$ref": "#/$defs/textArray", "minItems": 1},
        "operator_ids": {"$ref": "#/$defs/textArray", "minItems": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "riskDerivationStrategy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "strategy_id", "version", "compatible_prior_ids",
        "compatible_operator_ids", "target_modes"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "strategy_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "compatible_prior_ids": {"$ref": "#/$defs/textArray", "minItems": 1},
        "compatible_operator_ids": {"$ref": "#/$defs/textArray", "minItems": 1},
        "target_modes": {
          "$ref": "#/$defs/textArray",
          "items": {"enum": ["change", "project"]},
          "minItems": 1
        }
      }
    },
    "attackOperator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "operator_id", "name", "description", "action", "safety_boundary"],
      "properties": {
        "schema_version": {"const": 1},
        "operator_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "safety_boundary": {"type": "string", "minLength": 1}
      }
    },
    "failureChain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "chain_id", "steps", "consequence", "fact_ids"],
      "properties": {
        "schema_version": {"const": 1},
        "chain_id": {"type": "string", "minLength": 1},
        "steps": {"$ref": "#/$defs/textArray", "minItems": 1},
        "consequence": {"type": "string", "minLength": 1},
        "fact_ids": {"$ref": "#/$defs/textArray"},
        "causal_roles": {
          "$ref": "#/$defs/textArray",
          "items": {
            "enum": ["local_behavior", "dependency_propagation", "caller_constraint", "system_impact"]
          }
        }
      }
    },
    "riskHypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "hypothesis_id", "target_id", "quality_property", "assumptions",
        "trigger", "mechanism", "consequence", "rationale", "required_evidence", "confidence",
        "status", "supporting_fact_ids", "unknowns"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "hypothesis_id": {"type": "string", "minLength": 1},
        "target_id": {"type": "string", "minLength": 1},
        "quality_property": {"type": "string", "minLength": 1},
        "assumptions": {"$ref": "#/$defs/textArray"},
        "trigger": {"type": "string", "minLength": 1},
        "mechanism": {"type": "string", "minLength": 1},
        "consequence": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "required_evidence": {"$ref": "#/$defs/textArray", "minItems": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "status": {"enum": ["draft", "frozen", "supported", "rejected", "inconclusive"]},
        "supporting_fact_ids": {"$ref": "#/$defs/textArray", "minItems": 1},
        "prior_id": {"type": "string", "minLength": 1},
        "failure_chain_id": {"type": "string", "minLength": 1},
        "behavior_delta_id": {"type": "string", "minLength": 1},
        "contract_drift_id": {"type": "string", "minLength": 1},
        "priority_id": {"type": "string", "minLength": 1},
        "unknowns": {"$ref": "#/$defs/textArray"}
      }
    },
    "hypothesisGeneratorIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "role", "backend", "requested_model", "effective_model",
        "invocation_id", "identity_sha256"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "role": {"type": "string", "minLength": 1},
        "backend": {"type": "string", "minLength": 1},
        "requested_model": {"type": "string", "minLength": 1},
        "effective_model": {"type": "string", "minLength": 1},
        "invocation_id": {"type": "string", "minLength": 1},
        "identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "hypothesisGenerationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "request_id", "target", "graph", "approved_priors", "budget"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "request_id": {"type": "string", "minLength": 1},
        "target": {"$ref": "#/$defs/projectTarget"},
        "graph": {"$ref": "#/$defs/contextGraph"},
        "approved_priors": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"$ref": "#/$defs/riskPrior"}
        },
        "budget": {"type": "integer", "minimum": 1}
      }
    },
    "hypothesisCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "candidate_id", "prior_id", "operator_id", "hypothesis",
        "failure_chain", "uncertainty"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "candidate_id": {"type": "string", "minLength": 1},
        "prior_id": {"type": "string", "minLength": 1},
        "operator_id": {"type": "string", "minLength": 1},
        "hypothesis": {"$ref": "#/$defs/riskHypothesis"},
        "failure_chain": {"$ref": "#/$defs/failureChain"},
        "uncertainty": {"$ref": "#/$defs/textArray", "minItems": 1}
      }
    },
    "candidateRejection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "candidate_id", "raw_sha256", "reasons"],
      "properties": {
        "schema_version": {"const": 1},
        "candidate_id": {"type": "string", "minLength": 1},
        "raw_sha256": {"$ref": "#/$defs/sha256"},
        "reasons": {"$ref": "#/$defs/textArray", "minItems": 1},
        "prior_id": {"type": "string", "minLength": 1}
      }
    },
    "hypothesisGenerationResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "request_id", "target_id", "graph_sha256", "generator_identity",
        "authoritative_output_sha256", "candidates", "rejected_candidates", "status"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "request_id": {"type": "string", "minLength": 1},
        "target_id": {"type": "string", "minLength": 1},
        "graph_sha256": {"$ref": "#/$defs/sha256"},
        "generator_identity": {"$ref": "#/$defs/hypothesisGeneratorIdentity"},
        "authoritative_output_sha256": {"$ref": "#/$defs/sha256"},
        "candidates": {"type": "array", "items": {"$ref": "#/$defs/hypothesisCandidate"}},
        "rejected_candidates": {"type": "array", "items": {"$ref": "#/$defs/candidateRejection"}},
        "status": {"enum": ["complete", "partial", "rejected"]}
      }
    },
    "hypothesisPortfolioItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "candidate_id", "prior_id", "operator_id", "hypothesis",
        "failure_chain", "priority"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "candidate_id": {"type": "string", "minLength": 1},
        "prior_id": {"type": "string", "minLength": 1},
        "operator_id": {"type": "string", "minLength": 1},
        "hypothesis": {"$ref": "#/$defs/riskHypothesis"},
        "failure_chain": {"$ref": "#/$defs/failureChain"},
        "priority": {"$ref": "#/$defs/riskPriority"}
      }
    },
    "hypothesisPortfolio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "portfolio_id", "request_id", "target_id", "source_origin",
        "source_commit", "source_tree_sha256", "graph_sha256", "generator_identity",
        "authoritative_output_sha256", "approved_prior_ids", "candidates", "selected",
        "rejected_candidates", "selection_ledger", "budget", "budget_consumed",
        "remaining_budget", "remaining_prior_ids", "remaining_fact_ids", "coverage_frontier",
        "status"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "portfolio_id": {"type": "string", "minLength": 1},
        "request_id": {"type": "string", "minLength": 1},
        "target_id": {"type": "string", "minLength": 1},
        "source_origin": {"type": "string", "minLength": 1},
        "source_commit": {"type": "string", "minLength": 1},
        "source_tree_sha256": {"$ref": "#/$defs/sha256"},
        "graph_sha256": {"$ref": "#/$defs/sha256"},
        "generator_identity": {"$ref": "#/$defs/hypothesisGeneratorIdentity"},
        "authoritative_output_sha256": {"$ref": "#/$defs/sha256"},
        "approved_prior_ids": {"$ref": "#/$defs/textArray", "minItems": 3, "maxItems": 3},
        "candidates": {"type": "array", "items": {"$ref": "#/$defs/hypothesisCandidate"}},
        "selected": {
          "type": "array",
          "maxItems": 3,
          "items": {"$ref": "#/$defs/hypothesisPortfolioItem"}
        },
        "rejected_candidates": {"type": "array", "items": {"$ref": "#/$defs/candidateRejection"}},
        "selection_ledger": {"$ref": "#/$defs/hypothesisSelectionLedger"},
        "budget": {"type": "integer", "minimum": 1},
        "budget_consumed": {"type": "integer", "minimum": 0},
        "remaining_budget": {"type": "integer", "minimum": 0},
        "remaining_prior_ids": {"$ref": "#/$defs/textArray"},
        "remaining_fact_ids": {"$ref": "#/$defs/textArray"},
        "coverage_frontier": {"$ref": "#/$defs/textArray"},
        "status": {"enum": ["frozen", "rejected"]}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "frozen"}}},
          "then": {"properties": {"selected": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"status": {"const": "rejected"}}},
          "then": {"properties": {"selected": {"maxItems": 0}}}
        }
      ]
    },
    "plannerIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "role", "backend", "requested_model", "effective_model", "invocation_id", "identity_sha256"],
      "properties": {
