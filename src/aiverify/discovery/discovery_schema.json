      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "evidence_id", "target_id", "hypothesis_id", "attempt_ref",
        "execution_record_ref", "outcome", "evidence_refs", "claim_boundary", "rationale", "accountable"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "evidence_id": {"type": "string", "minLength": 1},
        "target_id": {"type": "string", "minLength": 1},
        "hypothesis_id": {"type": "string", "minLength": 1},
        "attempt_ref": {"type": "string", "minLength": 1},
        "execution_record_ref": {"type": "string", "minLength": 1},
        "outcome": {"enum": ["supported", "rejected", "inconclusive", "non_accountable"]},
        "evidence_refs": {"$ref": "#/$defs/textArray"},
        "claim_boundary": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "accountable": {"type": "boolean"},
        "execution_identity_sha256": {"$ref": "#/$defs/sha256"}
      },
      "allOf": [
        {
          "if": {"properties": {"outcome": {"enum": ["supported", "rejected", "inconclusive"]}}},
          "then": {
            "required": ["execution_identity_sha256"],
            "properties": {"evidence_refs": {"minItems": 1}, "accountable": {"const": true}}
          }
        },
        {
          "if": {"properties": {"outcome": {"const": "non_accountable"}}},
          "then": {"properties": {"accountable": {"const": false}}}
        }
      ]
    },
