{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/aiverify/discovery-schema-v1.json",
  "title": "AI Verification M7 discovery contracts",
  "type": "object",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "textArray": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "locator": {"type": "string", "minLength": 1}
      }
    },
    "contextFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_id", "subject", "predicate", "value", "source_kind",
        "provenance", "source_version", "confidence", "status"
      ],
      "properties": {
        "fact_id": {"type": "string", "minLength": 1},
        "subject": {"type": "string", "minLength": 1},
        "predicate": {"type": "string", "minLength": 1},
        "value": {},
        "source_kind": {
          "enum": ["declared", "derived", "observed", "historical", "unknown"]
        },
        "provenance": {
          "type": "array",
          "items": {"$ref": "#/$defs/provenance"}
        },
        "source_version": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "status": {"enum": ["known", "unknown", "contradictory", "stale"]},
        "rationale": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "unknown"}}},
          "then": {
            "properties": {"source_kind": {"const": "unknown"}, "rationale": {"type": "string", "minLength": 1}},
            "required": ["rationale"]
          }
        },
        {
          "if": {"properties": {"status": {"enum": ["known", "contradictory", "stale"]}}},
          "then": {"properties": {"provenance": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"source_kind": {"const": "unknown"}}},
          "then": {"properties": {"status": {"const": "unknown"}}}
        }
      ]
    },
    "contextGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "graph_id", "target_id", "facts"],
      "properties": {
        "schema_version": {"const": 1},
        "graph_id": {"type": "string", "minLength": 1},
        "target_id": {"type": "string", "minLength": 1},
        "facts": {
          "type": "array",
          "items": {"$ref": "#/$defs/contextFact"}
        }
      }
    },
    "changeTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "schema_version", "target_id", "source_origin", "source_commit",
        "worktree", "diff_ref", "diff_sha256"
      ],
      "properties": {
        "kind": {"const": "change"},
        "schema_version": {"const": 1},
        "target_id": {"type": "string", "minLength": 1},
        "source_origin": {"type": "string", "minLength": 1},
        "source_commit": {"type": "string", "minLength": 1},
        "worktree": {"type": "string", "minLength": 1},
        "diff_ref": {"type": "string", "minLength": 1},
        "diff_sha256": {"$ref": "#/$defs/sha256"},
        "spec_ref": {"type": "string", "minLength": 1}
      }
    },
    "projectTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "schema_version", "target_id", "source_origin", "source_commit",
        "worktree", "scope", "discovery_budget"
      ],
      "properties": {
        "kind": {"const": "project"},
        "schema_version": {"const": 1},
        "target_id": {"type": "string", "minLength": 1},
        "source_origin": {"type": "string", "minLength": 1},
        "source_commit": {"type": "string", "minLength": 1},
        "worktree": {"type": "string", "minLength": 1},
        "scope": {"$ref": "#/$defs/textArray", "minItems": 1},
        "discovery_budget": {"type": "integer", "minimum": 1}
      }
    },
    "target": {
      "oneOf": [
        {"$ref": "#/$defs/changeTarget"},
        {"$ref": "#/$defs/projectTarget"}
      ]
    },
    "qualityContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "contract_id", "name", "scope", "quality_property", "constraint", "source_fact_ids", "status"],
      "properties": {
        "schema_version": {"const": 1},
        "contract_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "quality_property": {"type": "string", "minLength": 1},
        "constraint": {"type": "string", "minLength": 1},
        "source_fact_ids": {"$ref": "#/$defs/textArray", "minItems": 1},
        "status": {"enum": ["declared", "derived", "observed", "unknown"]}
      }
    },
    "contractDrift": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "drift_id", "contract_id", "before", "after", "delta", "source_fact_ids", "status", "rationale"],
      "properties": {
        "schema_version": {"const": 1},
        "drift_id": {"type": "string", "minLength": 1},
        "contract_id": {"type": "string", "minLength": 1},
        "before": {"type": "string", "minLength": 1},
        "after": {"type": "string", "minLength": 1},
        "delta": {"type": "string", "minLength": 1},
        "source_fact_ids": {"$ref": "#/$defs/textArray", "minItems": 1},
        "status": {"enum": ["suspected", "observed", "contradictory", "unknown"]},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "riskPrior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "prior_id", "name", "description", "signals", "operator_ids", "version"],
      "properties": {
        "schema_version": {"const": 1},
        "prior_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "signals": {"$ref": "#/$defs/textArray", "minItems": 1},
        "operator_ids": {"$ref": "#/$defs/textArray", "minItems": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "attackOperator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "operator_id", "name", "description", "action", "safety_boundary"],
      "properties": {
        "schema_version": {"const": 1},
        "operator_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "safety_boundary": {"type": "string", "minLength": 1}
      }
    },
    "failureChain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "chain_id", "steps", "consequence", "fact_ids"],
      "properties": {
        "schema_version": {"const": 1},
        "chain_id": {"type": "string", "minLength": 1},
        "steps": {"$ref": "#/$defs/textArray", "minItems": 1},
        "consequence": {"type": "string", "minLength": 1},
        "fact_ids": {"$ref": "#/$defs/textArray"}
      }
    },
    "riskHypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "hypothesis_id", "target_id", "quality_property", "assumptions",
        "trigger", "mechanism", "consequence", "rationale", "required_evidence", "confidence",
        "status", "supporting_fact_ids", "unknowns"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "hypothesis_id": {"type": "string", "minLength": 1},
        "target_id": {"type": "string", "minLength": 1},
        "quality_property": {"type": "string", "minLength": 1},
        "assumptions": {"$ref": "#/$defs/textArray"},
        "trigger": {"type": "string", "minLength": 1},
        "mechanism": {"type": "string", "minLength": 1},
        "consequence": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "required_evidence": {"$ref": "#/$defs/textArray", "minItems": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "status": {"enum": ["draft", "frozen", "supported", "rejected", "inconclusive"]},
        "supporting_fact_ids": {"$ref": "#/$defs/textArray", "minItems": 1},
        "prior_id": {"type": "string", "minLength": 1},
        "failure_chain_id": {"type": "string", "minLength": 1},
        "unknowns": {"$ref": "#/$defs/textArray"}
      }
    },
    "attackPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "plan_id", "target_id", "hypothesis_id", "operator_id", "trigger",
        "observations", "evidence_expectations", "oracle", "abort_boundary", "claim_boundary",
        "fixture_refs", "experiment_refs", "status"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "plan_id": {"type": "string", "minLength": 1},
        "target_id": {"type": "string", "minLength": 1},
        "hypothesis_id": {"type": "string", "minLength": 1},
        "operator_id": {"type": "string", "minLength": 1},
        "trigger": {"type": "string"},
        "observations": {"$ref": "#/$defs/textArray"},
        "evidence_expectations": {"$ref": "#/$defs/textArray"},
        "oracle": {"type": "string"},
        "abort_boundary": {"type": "string"},
        "claim_boundary": {"type": "string"},
        "fixture_refs": {"$ref": "#/$defs/textArray"},
        "experiment_refs": {"$ref": "#/$defs/textArray"},
        "status": {"enum": ["draft", "admitted", "rejected"]}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "finding_id", "target_id", "hypothesis_id", "conclusion", "evidence_refs", "impact", "claim_boundary", "rationale"],
      "properties": {
        "schema_version": {"const": 1},
        "finding_id": {"type": "string", "minLength": 1},
        "target_id": {"type": "string", "minLength": 1},
        "hypothesis_id": {"type": "string", "minLength": 1},
        "conclusion": {"enum": ["supported", "rejected", "inconclusive"]},
        "evidence_refs": {"$ref": "#/$defs/textArray", "minItems": 1},
        "impact": {"type": "string", "minLength": 1},
        "claim_boundary": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "residualRisk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "risk_id", "target_id", "hypothesis_id", "reason", "evidence_gap", "scope", "basis_refs", "status"],
      "properties": {
        "schema_version": {"const": 1},
        "risk_id": {"type": "string", "minLength": 1},
        "target_id": {"type": "string", "minLength": 1},
        "hypothesis_id": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "evidence_gap": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "basis_refs": {"$ref": "#/$defs/textArray", "minItems": 1},
        "next_probe": {"type": "string", "minLength": 1},
        "status": {"enum": ["open", "accepted", "closed"]}
      }
    },
    "projectRiskMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "map_id", "target_id", "findings", "residual_risks", "explored_fact_ids", "coverage_frontier"],
      "properties": {
        "schema_version": {"const": 1},
        "map_id": {"type": "string", "minLength": 1},
        "target_id": {"type": "string", "minLength": 1},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "residual_risks": {"type": "array", "items": {"$ref": "#/$defs/residualRisk"}},
        "explored_fact_ids": {"$ref": "#/$defs/textArray"},
        "coverage_frontier": {"$ref": "#/$defs/textArray", "minItems": 1}
      }
    },
    "discoveryCampaign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "campaign_id", "target", "context_graph", "quality_contracts", "contract_drifts",
        "risk_priors", "attack_operators", "hypotheses", "failure_chains", "attack_plans", "experiment_refs",
        "findings", "residual_risks", "status"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "campaign_id": {"type": "string", "minLength": 1},
        "target": {"$ref": "#/$defs/target"},
        "context_graph": {"$ref": "#/$defs/contextGraph"},
        "quality_contracts": {"type": "array", "items": {"$ref": "#/$defs/qualityContract"}},
        "contract_drifts": {"type": "array", "items": {"$ref": "#/$defs/contractDrift"}},
        "risk_priors": {"type": "array", "items": {"$ref": "#/$defs/riskPrior"}},
        "attack_operators": {"type": "array", "items": {"$ref": "#/$defs/attackOperator"}},
        "hypotheses": {"type": "array", "items": {"$ref": "#/$defs/riskHypothesis"}},
        "failure_chains": {"type": "array", "items": {"$ref": "#/$defs/failureChain"}},
        "attack_plans": {"type": "array", "items": {"$ref": "#/$defs/attackPlan"}},
        "experiment_refs": {"$ref": "#/$defs/textArray"},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "residual_risks": {"type": "array", "items": {"$ref": "#/$defs/residualRisk"}},
        "project_risk_map": {"$ref": "#/$defs/projectRiskMap"},
        "status": {"enum": ["draft", "admitted", "running", "completed", "inconclusive"]}
      }
    },
    "admissionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "status", "errors"],
      "properties": {
        "schema_version": {"const": 1},
        "status": {"enum": ["admitted", "rejected"]},
        "errors": {"$ref": "#/$defs/textArray"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "admitted"}}},
          "then": {"properties": {"errors": {"maxItems": 0}}}
        },
        {
          "if": {"properties": {"status": {"const": "rejected"}}},
          "then": {"properties": {"errors": {"minItems": 1}}}
        }
      ]
    }
  }
}
