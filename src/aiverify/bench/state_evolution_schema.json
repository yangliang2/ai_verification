{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/aiverify/state-evolution-fixture-schema-v1.json",
  "title": "AI Verification M8 state-evolution fixture contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "contract_id", "fixture_pair_id", "package", "activity",
    "old_state", "current_state", "migration", "recovery", "quality_contract",
    "resources", "provenance"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "contract_id": {"type": "string", "minLength": 1},
    "fixture_pair_id": {"type": "string", "minLength": 1},
    "package": {"type": "string", "minLength": 1},
    "activity": {"type": "string", "minLength": 1},
    "old_state": {"$ref": "#/$defs/state"},
    "current_state": {"$ref": "#/$defs/state"},
    "migration": {"$ref": "#/$defs/migration"},
    "recovery": {"$ref": "#/$defs/recovery"},
    "quality_contract": {"$ref": "#/$defs/qualityContract"},
    "resources": {"$ref": "#/$defs/resources"},
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/provenance"}
    }
  },
  "$defs": {
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sentinel", "schema_version", "revision", "migration_status"],
      "properties": {
        "sentinel": {"type": "string", "minLength": 1},
        "schema_version": {"type": "integer", "minimum": 1},
        "revision": {"type": "integer", "minimum": 0},
        "migration_status": {"type": "string", "minLength": 1},
        "snapshot_id": {"type": "string", "minLength": 1}
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_id", "from_schema", "to_schema", "from_revision", "to_revision",
        "operation", "exactly_once"
      ],
      "properties": {
        "edge_id": {"type": "string", "minLength": 1},
        "from_schema": {"type": "integer", "minimum": 1},
        "to_schema": {"type": "integer", "minimum": 1},
        "from_revision": {"type": "integer", "minimum": 0},
        "to_revision": {"type": "integer", "minimum": 0},
        "operation": {"type": "string", "minLength": 1},
        "exactly_once": {"type": "boolean"}
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boundary_id", "events", "timeout_seconds", "reversible", "local_only"],
      "properties": {
        "boundary_id": {"type": "string", "minLength": 1},
        "events": {
          "type": "array",
          "const": ["rotate", "process_death", "backup_restore"]
        },
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "reversible": {"const": true},
        "local_only": {"const": true}
      }
    },
    "qualityContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "property", "constraint", "source_fact_ids"],
      "properties": {
        "contract_id": {"type": "string", "minLength": 1},
        "property": {"type": "string", "minLength": 1},
        "constraint": {"type": "string", "minLength": 1},
        "source_fact_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sentinel", "schema_version", "revision", "migration_status"],
      "properties": {
        "sentinel": {"type": "string", "minLength": 1},
        "schema_version": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "migration_status": {"type": "string", "minLength": 1}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "source_sha256", "locator"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "locator": {"type": "string", "minLength": 1}
      }
    }
  }
}
