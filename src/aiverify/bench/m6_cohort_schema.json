{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M6 Qualification Cohort Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cohort_id",
    "status",
    "frozen_at",
    "maintainer_approval",
    "environment",
    "policy",
    "slots",
    "replacement_pool",
    "exclusions",
    "replacement_events",
    "execution_state"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "cohort_id": {
      "type": "string",
      "pattern": "^m6-[a-z0-9][a-z0-9-]*-v[1-9][0-9]*$"
    },
    "status": {
      "enum": ["draft", "frozen"]
    },
    "frozen_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "maintainer_approval": {
      "$ref": "#/$defs/maintainerApproval"
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "policy": {
      "$ref": "#/$defs/policy"
    },
    "slots": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/slot"
      }
    },
    "replacement_pool": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/replacementCandidate"
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exclusion"
      }
    },
    "replacement_events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/replacementEvent"
      }
    },
    "execution_state": {
      "$ref": "#/$defs/executionState"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "stableId": {
      "type": "string",
      "pattern": "^[A-Z]-[0-9]{2}$"
    },
    "candidateId": {
      "type": "string",
      "pattern": "^[A-Z]+-[A-Z0-9][A-Z0-9-]*$"
    },
    "riskFamily": {
      "enum": [
        "G-01",
        "G-02",
        "G-03",
        "G-04",
        "G-05",
        "G-06",
        "G-07",
        "G-08"
      ]
    },
    "repoPath": {
      "type": "string",
      "minLength": 1
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "$ref": "#/$defs/repoPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "maintainerApproval": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["issue_url", "comment_url", "approved_by", "approved_at"],
      "properties": {
        "issue_url": {
          "type": "string",
          "format": "uri"
        },
        "comment_url": {
          "type": "string",
          "format": "uri"
        },
        "approved_by": {
          "type": "string",
          "minLength": 1
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_level",
        "avd",
        "form_factor",
        "locale",
        "orientation"
      ],
      "properties": {
        "api_level": {
          "type": "integer",
          "minimum": 21
        },
        "avd": {
          "type": "string",
          "minLength": 1
        },
        "form_factor": {
          "enum": ["phone", "tablet"]
        },
        "locale": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
        },
        "orientation": {
          "enum": ["portrait", "landscape"]
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_base",
        "adb_fallback",
        "verification_backend",
        "public_runner",
        "default_device"
      ],
      "properties": {
        "execution_base": {
          "const": "android_cli_first"
        },
        "adb_fallback": {
          "const": "bounded_recorded"
        },
        "verification_backend": {
          "const": "codex_cli"
        },
        "public_runner": {
          "const": "python -m aiverify.runner"
        },
        "default_device": {
          "$ref": "#/$defs/device"
        }
      }
    },
    "formalLanes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planned_cases",
        "baseline_repetitions_per_case",
        "candidate_repetitions_per_case",
        "planned_lanes"
      ],
      "properties": {
        "planned_cases": {
          "const": 6
        },
        "baseline_repetitions_per_case": {
          "const": 3
        },
        "candidate_repetitions_per_case": {
          "const": 3
        },
        "planned_lanes": {
          "const": 36
        }
      }
    },
    "retryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_attempts_per_lane",
        "retryable_failure_classes",
        "no_retry_after_accountable"
      ],
      "properties": {
        "max_attempts_per_lane": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "retryable_failure_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "no_retry_after_accountable": {
          "const": true
        }
      }
    },
    "replacementPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "before_first_formal_invocation_only",
        "preserve_exclusions_outside_denominator",
        "same_track_only"
      ],
      "properties": {
        "before_first_formal_invocation_only": {
          "const": true
        },
        "preserve_exclusions_outside_denominator": {
          "const": true
        },
        "same_track_only": {
          "const": true
        }
      }
    },
    "blindingPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "separate_development_and_verification_sessions",
        "candidate_frozen_before_verification",
        "withhold_task_identity",
        "withhold_fix_history",
        "verifier_network_policy"
      ],
      "properties": {
        "separate_development_and_verification_sessions": {
          "const": true
        },
        "candidate_frozen_before_verification": {
          "const": true
        },
        "withhold_task_identity": {
          "const": true
        },
        "withhold_fix_history": {
          "const": true
        },
        "verifier_network_policy": {
          "enum": ["disabled", "recorded"]
        }
      }
    },
    "claimPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "track_denominators_separate",
        "historical_allowed",
        "prospective_allowed",
        "forbidden"
      ],
      "properties": {
        "track_denominators_separate": {
          "const": true
        },
        "historical_allowed": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "prospective_allowed": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "forbidden": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "qualificationThresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventually_accountable_lanes",
        "historical_fixed_controls_pass",
        "historical_prefix_revisions_fail_expected_oracle",
        "prospective_conclusions_independently_adjudicated",
        "unexplained_contradictions",
        "independent_final_auditors"
      ],
      "properties": {
        "eventually_accountable_lanes": {
          "const": 36
        },
        "historical_fixed_controls_pass": {
          "const": 9
        },
        "historical_prefix_revisions_fail_expected_oracle": {
          "const": 9
        },
        "prospective_conclusions_independently_adjudicated": {
          "const": 3
        },
        "unexplained_contradictions": {
          "const": 0
        },
        "independent_final_auditors": {
          "const": 1
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formal_lanes",
        "retry",
        "replacement",
        "blinding",
        "claims",
        "qualification_thresholds",
        "failure_routes"
      ],
      "properties": {
        "formal_lanes": {
          "$ref": "#/$defs/formalLanes"
        },
        "retry": {
          "$ref": "#/$defs/retryPolicy"
        },
        "replacement": {
          "$ref": "#/$defs/replacementPolicy"
        },
        "blinding": {
          "$ref": "#/$defs/blindingPolicy"
        },
        "claims": {
          "$ref": "#/$defs/claimPolicy"
        },
        "qualification_thresholds": {
          "$ref": "#/$defs/qualificationThresholds"
        },
        "failure_routes": {
          "type": "object",
          "minProperties": 4,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_url", "task_url", "base_revision"],
      "properties": {
        "repository_url": {
          "type": "string",
          "format": "uri"
        },
        "task_url": {
          "type": "string",
          "format": "uri"
        },
        "base_revision": {
          "$ref": "#/$defs/gitRevision"
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "contract", "status"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "contract": {
          "$ref": "#/$defs/artifactRef"
        },
        "status": {
          "const": "qualified"
        }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "expected_class"],
      "properties": {
        "contract": {
          "$ref": "#/$defs/artifactRef"
        },
        "expected_class": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "repetitions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "candidate"],
      "properties": {
        "baseline": {
          "const": 3
        },
        "candidate": {
          "const": 3
        }
      }
    },
    "replacementEligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible", "cutoff"],
      "properties": {
        "eligible": {
          "const": true
        },
        "cutoff": {
          "const": "before_first_formal_invocation"
        }
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence", "admitted_at"],
      "properties": {
        "status": {
          "const": "qualified"
        },
        "evidence": {
          "$ref": "#/$defs/artifactRef"
        },
        "admitted_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "historicalAdmission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upstream_task_id",
        "pair_kind",
        "pre_fix_revision",
        "fixed_revision",
        "matched_fail_pass",
        "reverse_applied",
        "synthetic",
        "pre_fix_expected",
        "fixed_expected"
      ],
      "properties": {
        "upstream_task_id": {
          "type": "string",
          "pattern": "^T[1-9][0-9]*$"
        },
        "pair_kind": {
          "const": "exact_revision"
        },
        "pre_fix_revision": {
          "$ref": "#/$defs/gitRevision"
        },
        "fixed_revision": {
          "$ref": "#/$defs/gitRevision"
        },
        "matched_fail_pass": {
          "const": true
        },
        "reverse_applied": {
          "const": false
        },
        "synthetic": {
          "const": false
        },
        "pre_fix_expected": {
          "const": "locally_rejected"
        },
        "fixed_expected": {
          "const": "locally_supported"
        }
      }
    },
    "prospectiveAdmission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upstream_task_id",
        "upstream_state",
        "assignee",
        "competing_implementation",
        "eligibility_snapshot",
        "development_input",
        "separate_sessions_required",
        "candidate_freeze_required",
        "withhold_task_identity",
        "withhold_fix_history",
        "verifier_network_policy",
        "no_upstream_interaction"
      ],
      "properties": {
        "upstream_task_id": {
          "type": "string",
          "pattern": "^T[1-9][0-9]*$"
        },
        "upstream_state": {
          "const": "open"
        },
        "assignee": {
          "type": "null"
        },
        "competing_implementation": {
          "const": false
        },
        "eligibility_snapshot": {
          "$ref": "#/$defs/artifactRef"
        },
        "development_input": {
          "$ref": "#/$defs/artifactRef"
        },
        "separate_sessions_required": {
          "const": true
        },
        "candidate_freeze_required": {
          "const": true
        },
        "withhold_task_identity": {
          "const": true
        },
        "withhold_fix_history": {
          "const": true
        },
        "verifier_network_policy": {
          "enum": ["disabled", "recorded"]
        },
        "no_upstream_interaction": {
          "const": true
        }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "track",
        "source",
        "risk_family",
        "primary_behavior",
        "fixture",
        "run_spec",
        "oracle",
        "device_configuration",
        "repetitions",
        "retry_policy_ref",
        "evidence_root",
        "replacement_eligibility",
        "admission"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "track": {
          "enum": ["historical", "prospective"]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "risk_family": {
          "$ref": "#/$defs/riskFamily"
        },
        "primary_behavior": {
          "type": "string",
          "minLength": 1
        },
        "fixture": {
          "$ref": "#/$defs/fixture"
        },
        "run_spec": {
          "$ref": "#/$defs/artifactRef"
        },
        "oracle": {
          "$ref": "#/$defs/oracle"
        },
        "device_configuration": {
          "$ref": "#/$defs/device"
        },
        "repetitions": {
          "$ref": "#/$defs/repetitions"
        },
        "retry_policy_ref": {
          "const": "policy.retry"
        },
        "evidence_root": {
          "$ref": "#/$defs/repoPath"
        },
        "replacement_eligibility": {
          "$ref": "#/$defs/replacementEligibility"
        },
        "admission": {
          "$ref": "#/$defs/admission"
        },
        "historical": {
          "$ref": "#/$defs/historicalAdmission"
        },
        "prospective": {
          "$ref": "#/$defs/prospectiveAdmission"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "track": {
                "const": "historical"
              }
            }
          },
          "then": {
            "required": ["historical"],
            "not": {
              "required": ["prospective"]
            }
          },
          "else": {
            "required": ["prospective"],
            "not": {
              "required": ["historical"]
            }
          }
        }
      ]
    },
    "replacementCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "track",
        "rank",
        "source",
        "risk_family",
        "primary_behavior",
        "preliminary_fixture",
        "admission_required"
      ],
      "properties": {
        "candidate_id": {
          "$ref": "#/$defs/candidateId"
        },
        "track": {
          "enum": ["historical", "prospective"]
        },
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "risk_family": {
          "$ref": "#/$defs/riskFamily"
        },
        "primary_behavior": {
          "type": "string",
          "minLength": 1
        },
        "preliminary_fixture": {
          "$ref": "#/$defs/repoPath"
        },
        "admission_required": {
          "const": true
        },
        "historical": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pre_fix_revision", "fixed_revision", "pair_kind"],
          "properties": {
            "pre_fix_revision": {
              "$ref": "#/$defs/gitRevision"
            },
            "fixed_revision": {
              "$ref": "#/$defs/gitRevision"
            },
            "pair_kind": {
              "const": "exact_revision"
            }
          }
        },
        "prospective": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "upstream_state",
            "assignee",
            "competing_implementation",
            "eligibility_snapshot",
            "no_upstream_interaction"
          ],
          "properties": {
            "upstream_state": {
              "const": "open"
            },
            "assignee": {
              "type": "null"
            },
            "competing_implementation": {
              "const": false
            },
            "eligibility_snapshot": {
              "$ref": "#/$defs/artifactRef"
            },
            "no_upstream_interaction": {
              "const": true
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "track": {
                "const": "historical"
              }
            }
          },
          "then": {
            "required": ["historical"],
            "not": {
              "required": ["prospective"]
            }
          },
          "else": {
            "required": ["prospective"],
            "not": {
              "required": ["historical"]
            }
          }
        }
      ]
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "track",
        "source",
        "reason",
        "evidence",
        "excluded_at"
      ],
      "properties": {
        "candidate_id": {
          "$ref": "#/$defs/candidateId"
        },
        "track": {
          "enum": ["historical", "prospective"]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/artifactRef"
        },
        "excluded_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "replacementEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot_id",
        "candidate_id",
        "replaced_candidate_id",
        "occurred_at",
        "before_first_formal_invocation",
        "exclusion_evidence"
      ],
      "properties": {
        "slot_id": {
          "$ref": "#/$defs/stableId"
        },
        "candidate_id": {
          "$ref": "#/$defs/candidateId"
        },
        "replaced_candidate_id": {
          "$ref": "#/$defs/candidateId"
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "before_first_formal_invocation": {
          "const": true
        },
        "exclusion_evidence": {
          "$ref": "#/$defs/artifactRef"
        }
      }
    },
    "formalInvocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot_id", "lane_id", "started_at"],
      "properties": {
        "slot_id": {
          "$ref": "#/$defs/stableId"
        },
        "lane_id": {
          "type": "string",
          "minLength": 1
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "executionState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formal_invocations_started"],
      "properties": {
        "formal_invocations_started": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/formalInvocation"
          }
        }
      }
    }
  }
}
