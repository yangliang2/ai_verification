{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M7 blinded discovery qualification manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "qualification_id", "status", "frozen_at",
    "maintainer_approval", "source_identity", "environment", "budgets",
    "policy", "cells", "exclusions", "evidence", "adjudication",
    "contradictory_preflight"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "qualification_id": {"type": "string", "pattern": "^m7-[a-z0-9][a-z0-9-]*-v[1-9][0-9]*$"},
    "status": {"const": "frozen"},
    "frozen_at": {"type": "string", "format": "date-time"},
    "maintainer_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue_url", "comment_url", "approved_by", "approved_at"],
      "properties": {
        "issue_url": {"type": "string", "format": "uri"},
        "comment_url": {"type": "string", "format": "uri"},
        "approved_by": {"type": "string", "minLength": 1},
        "approved_at": {"type": "string", "format": "date-time"}
      }
    },
    "source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_id", "source_origin", "source_commit", "worktree", "context_manifest", "change_input"],
      "properties": {
        "fixture_id": {"type": "string", "minLength": 1},
        "source_origin": {"type": "string", "format": "uri"},
        "source_commit": {"type": "string", "minLength": 1},
        "worktree": {"type": "string", "minLength": 1},
        "context_manifest": {"$ref": "#/$defs/artifact"},
        "change_input": {"$ref": "#/$defs/artifact"}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner", "network", "android_execution", "device"],
      "properties": {
        "runner": {"const": "local-python"},
        "network": {"const": "disabled"},
        "android_execution": {"const": false},
        "device": {"const": "none"}
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discovery_budget", "context_expansion_budget", "max_attempts_per_lane"],
      "properties": {
        "discovery_budget": {"const": 8},
        "context_expansion_budget": {"const": 1},
        "max_attempts_per_lane": {"const": 1}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planned_lanes", "repetitions_per_cell", "retry", "blinding", "claim_boundary"],
      "properties": {
        "planned_lanes": {"const": 12},
        "repetitions_per_cell": {"const": 3},
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_attempts_per_lane", "no_retry_after_accountable"],
          "properties": {
            "max_attempts_per_lane": {"const": 1},
            "no_retry_after_accountable": {"const": true}
          }
        },
        "blinding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["withhold_variant", "withhold_expected_evidence", "withhold_verdict", "network_disabled"],
          "properties": {
            "withhold_variant": {"const": true},
            "withhold_expected_evidence": {"const": true},
            "withhold_verdict": {"const": true},
            "network_disabled": {"const": true}
          }
        },
        "claim_boundary": {"type": "string", "minLength": 1}
      }
    },
    "exclusions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["m6_lanes_in_denominator", "android_runtime_claim", "benchmark_rate_claim"],
      "properties": {
        "m6_lanes_in_denominator": {"const": false},
        "android_runtime_claim": {"const": false},
        "benchmark_rate_claim": {"const": false}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_refs", "checksums_required", "durable_run_record", "claim_boundary"],
      "properties": {
        "required_refs": {
          "type": "array",
          "const": ["execution_record", "execution_identity", "oracle"]
        },
        "checksums_required": {"const": true},
        "durable_run_record": {"type": "string", "minLength": 1},
        "claim_boundary": {"type": "string", "minLength": 1}
      }
    },
    "adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["independent", "auditor_id", "required_checks"],
      "properties": {
        "independent": {"const": true},
        "auditor_id": {"const": "m7-independent-adjudicator-v1"},
        "required_checks": {
          "type": "array",
          "const": [
            "hypothesis_relevance", "causal_chain", "experiment_validity",
            "finding_support", "residual_risk_honesty", "leakage_boundary"
          ]
        }
      }
    },
    "cells": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/cell"}
    },
    "contradictory_preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "formal_denominator", "route"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "formal_denominator": {"const": false},
        "route": {"const": "exclude_before_formal_invocation"}
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cell_id", "target_mode", "variant", "repetitions"],
      "properties": {
        "cell_id": {"enum": ["change-defect", "change-control", "project-defect", "project-control"]},
        "target_mode": {"enum": ["change", "project"]},
        "variant": {"enum": ["defect", "control"]},
        "repetitions": {"const": 3}
      }
    }
  }
}
