+def _check_project_campaign(
+    document: Mapping[str, Any],
+    *,
+    repo_root: Path,
+) -> tuple[tuple[list[Mapping[str, Any]], list[Mapping[str, Any]]], list[str]]:
+    """Re-run the side-effect-free ProjectTarget campaign seam at admission."""
+
+    checks: list[Mapping[str, Any]] = []
+    receipts: list[Mapping[str, Any]] = []
+    reasons: list[str] = []
+
+    def record(name: str, passed: bool, detail: str = "") -> None:
+        checks.append({"name": name, "status": "pass" if passed else "fail", "detail": detail})
+        if not passed:
+            reasons.append(f"project_campaign:{name}")
+
+    source = document["source_identity"]
+    project_target_path = repo_root / str(source["project_target"]["path"])
+    context_path = repo_root / str(source["context_manifest"]["path"])
+    try:
+        target_document = json.loads(project_target_path.read_text(encoding="utf-8"))
+        forbidden_fields = {
+            "diff",
+            "diff_ref",
+            "diff_sha256",
+            "expected_behavior",
+            "expected_evidence",
+            "expected_verdict",
+            "verdict",
+        }
+        leaked = sorted(forbidden_fields.intersection(target_document))
+        target = ProjectTarget.from_dict(target_document)
+        context = load_context_manifest(context_path, target).graph
+        record("project_target_packet", not leaked, f"forbidden_fields={leaked}")
+    except Exception as error:  # noqa: BLE001 - admission must fail closed
+        record("project_target_packet", False, f"{type(error).__name__}: {error}")
+        return (checks, receipts), reasons
+
+    build = document["build"]
+    campaign = document["campaign"]
+    scenario_data = campaign["scenario"]
+    scenario = ScenarioSpec(
+        id=str(scenario_data["id"]),
+        user_actions=[str(item) for item in scenario_data["user_actions"]],
+        assertions=[
+            AssertionSpec(
+                resource_id=str(item["resource_id"]),
+                attr=str(item["attr"]),
+                expected=str(item["expected"]),
+            )
+            for item in scenario_data["assertions"]
+        ],
+    )
+    variants = {str(item["cell_id"]): item for item in build["variants"]}
+    run_specs = {str(item["cell_id"]): item for item in document["run_specs"]}
+    for cell in document["cells"]:
+        cell_id = str(cell["cell_id"])
+        try:
+            request = ContextExpansionRequest(
+                request_id=f"{campaign['campaign_id_prefix']}-{cell_id}-context",
+                campaign_id=f"{campaign['campaign_id_prefix']}-{cell_id}",
+                target_id=target.target_id,
+                required_predicates=tuple(campaign["required_predicates"]),
+                probe_refs=tuple(campaign["probe_refs"]),
+                budget=int(campaign["context_budget"]),
+                unresolved_questions=tuple(campaign["unresolved_questions"]),
+            )
+            package = seed_project_campaign(
+                request.campaign_id,
+                target,
+                context,
+                context_request=request,
+            )
+            admission = admit_campaign_plan(package)
+            variant = variants[cell_id]
+            compiled = compile_attack_plan_to_run_spec(
+                admission.package,
+                host_project=str(build["host_project"]),
+                apk_glob=str(build["apk_relpath"]),
+                package_name=str(variant["package"]),
+                activity=str(variant["activity"]),
+                scenario=scenario,
+            )
+            static_path = repo_root / str(run_specs[cell_id]["path"])
+            static_spec = load_run_spec(static_path)
+            no_diff = compiled.run_spec.diff is None and static_spec.diff is None
+            no_labels = (
+                compiled.run_spec.scenario.expected_behavior == ""
+                and compiled.run_spec.scenario.metric_context.seed_kind == "unspecified"
+                and static_spec.scenario.expected_behavior == ""
+                and static_spec.scenario.metric_context.seed_kind == "unspecified"
+                and static_spec.scenario.metric_context.expected_oracle_level is None
+                and static_spec.scenario.metric_context.expected_oracle_defect_class is None
+            )
+            aligned = (
+                admission.admission.admitted
+                and static_spec.package == compiled.run_spec.package
+                and static_spec.activity == compiled.run_spec.activity
+                and static_spec.scenario.id == compiled.run_spec.scenario.id
+            )
+            passed = no_diff and no_labels and aligned
+            detail = (
+                f"admitted={admission.admission.admitted} no_diff={no_diff} "
+                f"no_labels={no_labels} aligned={aligned}"
+            )
+            record(f"campaign:{cell_id}", passed, detail)
+            receipt = {
+                "cell_id": cell_id,
+                "campaign_id": request.campaign_id,
+                "target_id": target.target_id,
+                "status": "admitted" if passed else "rejected",
+                "hypothesis_id": compiled.package.campaign.hypotheses[0].hypothesis_id,
+                "attack_plan_id": compiled.plan_id,
+                "run_spec": str(static_path),
+                "run_spec_sha256": _sha256_file(static_path),
+                "diff": None,
+                "no_outcome_labels": no_labels,
+            }
+            receipts.append(receipt)
+        except Exception as error:  # noqa: BLE001 - admission must fail closed
+            record(f"campaign:{cell_id}", False, f"{type(error).__name__}: {error}")
+    return (checks, receipts), reasons
+
+
